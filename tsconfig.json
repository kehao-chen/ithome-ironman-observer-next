{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  // worker/src/index.ts is typechecked by worker/tsconfig.json against
  // @cloudflare/workers-types (whose globals conflict with Bun's). Everything else
  // under worker/ — the platform-agnostic auth module and its tests — belongs here.
  "exclude": ["worker/src/index.ts", "worker/node_modules", "web/.astro", "node_modules", "web/node_modules"]
}
