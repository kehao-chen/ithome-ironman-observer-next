/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # `script-src` keeps 'unsafe-inline' because SSG inlines the dataset as
  # `window.IRONMAN_DATA` and the theme bootstrap must run before first paint —
  # a static `_headers` file cannot carry per-build nonces or hashes. It still
  # earns its place: no external origin can serve script, and object/base-uri/
  # form-action are shut off entirely. `style-src` needs 'unsafe-inline' for the
  # ~285 inline style attributes the card grid renders.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=60, stale-while-revalidate=300
