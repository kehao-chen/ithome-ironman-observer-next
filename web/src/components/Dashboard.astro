---
// web/src/components/Dashboard.astro
import SeriesCard from "./SeriesCard.astro";
import type { YearData } from "../../../scripts/types";

interface Props { data: YearData; years: number[] }
const { data, years } = Astro.props;
const groups = ["全部", ...data.groups];
const countFor = (g: string) => g === "全部" ? data.series.length : data.series.filter((s) => s.group === g).length;
const updatedAtFallback = data.updatedAt ? data.updatedAt.replace("T", " ").slice(0, 16) : "";
---

<header class="site-header container">
  <div class="header-row">
    <div class="brand">
      <h1 class="brand-title"><span class="brand-mark" aria-hidden="true"></span>鐵人觀察家 <span class="brand-year" id="brand-year">2026</span></h1>
      <p class="brand-sub">
        最後更新 <time id="updated-at" datetime={data.updatedAt} data-ts={data.updatedAt}>{updatedAtFallback}</time>
        · <span id="series-count" class="tabular-nums">{data.series.length}</span> 支系列
      </p>
    </div>
    <div class="header-actions">
      <select id="year-select" class="sort-select" aria-label="切換年度">
        {years.map((y) => <option value={y} selected={y === data.year}>{y} 年</option>)}
      </select>
      <div class="seg" role="group" aria-label="顯示模式">
        <button id="view-grid" class="seg-btn" type="button" data-view="grid" aria-pressed="true" title="卡片檢視">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1"/></svg>
        </button>
        <button id="view-list" class="seg-btn" type="button" data-view="list" aria-pressed="false" title="列表檢視">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3.5" cy="6" r="1.5" fill="currentColor" stroke="none"/><circle cx="3.5" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="3.5" cy="18" r="1.5" fill="currentColor" stroke="none"/></svg>
        </button>
      </div>
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="切換明暗主題" title="切換明暗主題（自動 / 明 / 暗）">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>
      <a class="icon-btn" href="/insights/" aria-label="Insights 分析" title="Insights 分析">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 14l4-5 3 3 5-7"/></svg>
      </a>
      <a class="icon-btn" href="https://github.com/kehao-chen/ithome-ironman-observer-next" target="_blank" rel="noopener" aria-label="GitHub 專案" title="GitHub 專案">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12 11.5 11.5 0 0 0 8.36 23c.57.1.78-.25.78-.55v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.42.36.79 1.08.79 2.18v3.23c0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" fill="currentColor" stroke="none"/></svg>
      </a>
    </div>
  </div>
  <div class="toolbar">
    <div class="toolbar-controls">
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
        <input type="search" id="search" class="search-input" aria-label="搜尋系列（標題／作者／組別／團隊）" placeholder="搜尋系列…" autocomplete="off" spellcheck="false" />
      </div>
      <div class="sort-wrap">
        <label for="sort" class="sort-label">排序</label>
        <div class="sort-select-wrap">
          <select id="sort" class="sort-select">
            <option value="dayCount">依進度</option>
            <option value="views">依觀看數</option>
            <option value="latest">今日發文</option>
          </select>
          <svg class="sort-caret" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </div>
      </div>
    </div>
    <div class="filter-row">
      <div class="filter-group" id="group-filters" role="group" aria-label="依組別篩選">
        <button data-group="fav" class="filter-btn" data-active="false">
          <span class="filter-label">我的收藏</span>
          <span class="filter-count tabular-nums" id="fav-count">0</span>
        </button>
        {groups.map((g) => (
          <button data-group={g} class="filter-btn" data-active={g === "全部" ? "true" : "false"}>
            <span class="filter-label">{g}</span>
            <span class="filter-count tabular-nums">{countFor(g)}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</header>

<main class="container" style="padding-block:var(--space-4);">
  <div class="status-bar" role="status">
    <span><span class="dot" aria-hidden="true"></span>資料已更新</span>
    <span>已顯示 <strong id="shown-count" class="tabular-nums">{data.series.length}</strong> / <strong id="total-count" class="tabular-nums">{data.series.length}</strong> 支系列</span>
    <details class="scrape-log" id="scrape-log" hidden={data.scrapeLog.length === 0}>
      <summary>⚠ <span id="scrape-log-count" class="tabular-nums">{data.scrapeLog.length}</span> 支系列本次抓取失敗</summary>
      <ul id="scrape-log-list">
        {data.scrapeLog.map((e) => <li>{e}</li>)}
      </ul>
    </details>
  </div>
  <div class="series-grid" id="series-list">
    {data.series.map((s) => <SeriesCard series={s} />)}
    <div class="fav-empty" id="fav-empty" role="status" aria-live="polite" tabindex="-1" hidden>
      <p>尚未收藏任何系列</p>
      <p class="fav-empty-hint">點卡片右上角星號開始追蹤你關心的系列。</p>
    </div>
  </div>
</main>

<!-- Shared RSS modal -->
<div class="modal" id="rss-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="rss-modal-title">
  <div class="modal-backdrop" data-close></div>
  <div class="modal-panel">
    <button class="modal-close" type="button" data-close aria-label="關閉">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
    <div class="rss-head">
      <svg class="rss-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/></svg>
      <h2 id="rss-modal-title">RSS 訂閱</h2>
    </div>
    <p class="rss-series" id="rss-modal-series"></p>
    <label class="rss-url-label" for="rss-url-input">訂閱網址</label>
    <div class="rss-url-row">
      <input id="rss-url-input" class="rss-url-input" type="text" readonly />
      <button id="rss-copy" class="rss-copy" type="button">複製</button>
    </div>
    <a id="rss-open" class="rss-open" href="#" target="_blank" rel="noopener">在瀏覽器開啟 RSS →</a>
    <p class="rss-hint">將此網址貼入你的 RSS 閱讀器（如 Feedly、Inoreader）即可訂閱此系列。</p>
  </div>
</div>

<script is:inline define:vars={{ initialData: data }}>
  window.IRONMAN_DATA = initialData;
</script>
<script>
  import { isDeletedSeries, statusChip, statusChipText, statusChipTitle, taipeiDay, taipeiToday } from "../lib/daily-status";
  import { loadFavorites, saveFavorites, toggleFavorite, isValidFavoriteId } from "../lib/favorites";
  import { hasSearchTokens, seriesMatchesQuery } from "../lib/search";
  import type { Series } from "../../../scripts/types";
  // window.localStorage getter 本身可能 throw（受限環境）；wrapper 統一降級為 null。
  function getStorage(): Pick<Storage, "getItem" | "setItem"> | null {
    try { return window.localStorage; } catch { return null; }
  }
  const storage = getStorage();
  let favSet = new Set<number>(loadFavorites(storage));
  const list = document.getElementById("series-list")!;
  const updatedAt = document.getElementById("updated-at")!;
  const seriesCount = document.getElementById("series-count")!;
  const shownCount = document.getElementById("shown-count")!;
  const totalCount = document.getElementById("total-count")!;
  let current: any = null;
  let currentYear: number = (window as any).IRONMAN_DATA?.year ?? 0;
  let fetchToken = 0;
  const yearSelect = document.getElementById("year-select") as HTMLSelectElement | null;
  const brandYear = document.getElementById("brand-year");
  const scrapeLog = document.getElementById("scrape-log");
  const scrapeLogCount = document.getElementById("scrape-log-count");
  const scrapeLogList = document.getElementById("scrape-log-list");
  let lastRenderedYear: number | null = null;

  async function loadYear(year: number) {
    const token = ++fetchToken;
    try {
      const res = await fetch(`/data/${year}.json?t=${Date.now()}`, { cache: "no-store" });
      if (!res.ok) return;
      const fresh = await res.json();
      if (token !== fetchToken) return; // stale response — a newer request owns the render
      render(fresh);
    } catch { /* keep current render */ }
  }

  let viewMode: "grid" | "list" = "grid";
  let today = taipeiToday(); // 跨日由 humanizeAll 週期校正
  let query = ""; // 搜尋 query（模組級 state；applyFilter 內直接讀取，年度切換保留）
  const searchInput = document.getElementById("search") as HTMLInputElement; // 供 applyFilter 空狀態 raw query 與事件使用

  /* ---------- Time humanization (browser timezone) ---------- */
  function tzTime(iso: string) {
    const d = new Date(iso);
    const abs = d.toLocaleString(undefined, { month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false });
    const full = d.toLocaleString(undefined, { year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false, timeZoneName: "short" });
    const diff = (Date.now() - d.getTime()) / 1000;
    let rel: string;
    if (diff < 60) rel = "剛剛";
    else if (diff < 3600) rel = `${Math.floor(diff / 60)} 分鐘前`;
    else if (diff < 86400) rel = `${Math.floor(diff / 3600)} 小時前`;
    else if (diff < 172800) rel = "昨天";
    else rel = abs;
    return { abs, full, rel };
  }
  function humanizeAll() {
    document.querySelectorAll<HTMLElement>("[data-ts]").forEach((el) => {
      const iso = el.getAttribute("data-ts");
      if (!iso) return;
      const t = tzTime(iso);
      el.textContent = el.id === "updated-at" ? t.abs : t.rel;
      el.setAttribute("title", t.full);
    });
  }

  /* ---------- Card helpers ---------- */
  function totalViews(s: any) { return s.articles.reduce((n: number, a: any) => n + a.views, 0); }
  function latestPub(s: any) { return s.articles.length ? new Date(s.articles[s.articles.length - 1].publishedAt).getTime() : 0; }
  function lastPubIso(s: any): string | null { return s.articles.length ? s.articles[s.articles.length - 1].publishedAt : null; }
  function seriesUrl(s: any) { return `https://ithelp.ithome.com.tw/users/${s.user.id}/ironman/${s.id}`; }
  function profileUrl(s: any) { return `https://ithelp.ithome.com.tw/users/${s.user.id}`; }
  function rssUrl(s: any) { return `https://ithelp.ithome.com.tw/rss/series/${s.id}`; }
  function chip(s: any): HTMLElement | null {
    const c = statusChip(lastPubIso(s), s.dayCount, today, s.articleCount);
    if (!c) return null;
    const el = document.createElement("span");
    el.className = c.kind === "today" ? "status-chip"
      : c.kind === "yesterday" ? "status-chip status-chip--yesterday"
      : c.kind === "done" ? "status-chip status-chip--done"
      : c.kind === "deleted" ? "status-chip status-chip--deleted"
      : c.kind === "long-stale" ? "status-chip status-chip--long" : "status-chip status-chip--stale";
    el.textContent = statusChipText(c);
    const t = statusChipTitle(c);
    if (t) el.title = t;
    return el;
  }
  function badgeClass(s: any) {
    if (isDeletedSeries(s.dayCount, s.articleCount)) return "day-badge day-badge--deleted";
    if (s.dayCount >= 30) return "day-badge day-badge--done";
    if (s.dayCount === 0) return "day-badge day-badge--pending";
    return "day-badge";
  }
  function badgeText(s: any) {
    // 刪文案例保留歷史進度 DAY n（他奮鬥到哪天）；狀態由 chip 標示，badge 以 danger 色暗示異常。
    if (isDeletedSeries(s.dayCount, s.articleCount)) return `DAY ${s.dayCount}`;
    if (s.dayCount === 0) return "尚未開賽";
    if (s.dayCount >= 30) return "完賽";
    return `DAY ${s.dayCount}`;
  }
  const SVG_NS = "http://www.w3.org/2000/svg";
  // Trusted static icons built via DOM APIs (no innerHTML sinks); attributes
  // mirror the SSR markup in SeriesCard.astro exactly.
  function svgEl(tag: string, attrs: Record<string, string>, children: SVGElement[] = []): SVGElement {
    const el = document.createElementNS(SVG_NS, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
    for (const c of children) el.appendChild(c);
    return el;
  }
  const EYE_ICON = svgEl("svg", { class: "ico-eye", viewBox: "0 0 24 24", "aria-hidden": "true" }, [
    svgEl("path", { d: "M1 12s4-7.5 11-7.5S23 12 23 12s-4 7.5-11 7.5S1 12 1 12z" }),
    svgEl("circle", { cx: "12", cy: "12", r: "3", fill: "currentColor", stroke: "none" }),
  ]);
  const RSS_ICON = svgEl("svg", { viewBox: "0 0 24 24", "aria-hidden": "true" }, [
    svgEl("path", { d: "M4 11a9 9 0 0 1 9 9" }),
    svgEl("path", { d: "M4 4a16 16 0 0 1 16 16" }),
    svgEl("circle", { cx: "5", cy: "19", r: "1.5", fill: "currentColor", stroke: "none" }),
  ]);
  const FAV_ICON = svgEl("svg", { viewBox: "0 0 24 24", "aria-hidden": "true" }, [
    svgEl("path", { d: "M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.4l6.1-.9z" }),
  ]);
  const OPEN_ICON = svgEl("svg", { viewBox: "0 0 24 24", "aria-hidden": "true" }, [
    svgEl("path", { d: "M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" }),
    svgEl("polyline", { points: "15 3 21 3 21 9" }),
    svgEl("line", { x1: "10", y1: "14", x2: "21", y2: "3" }),
  ]);

  function groupCounts(data: any): Map<string, number> {
    const m = new Map<string, number>();
    m.set("全部", data.series.length); // matches SSR countFor("全部") semantics
    for (const s of data.series) m.set(s.group, (m.get(s.group) ?? 0) + 1);
    return m;
  }
  function currentGroup(): string {
    return document.querySelector(".filter-btn[data-active='true']")?.getAttribute("data-group") ?? "全部";
  }
  function isFavView(): boolean { return currentGroup() === "fav"; }
  // 目前年度資料中已收藏且存在的系列（收藏分頁的資料子集）。
  function favSeries(data: any): any[] { return data.series.filter((s: any) => favSet.has(s.id)); }
  // 收藏分頁的 shown/total 分母：目前年度可顯示收藏數。
  function currentYearFavCount(data: any): number { return favSeries(data).length; }
  // 年度切換時 resolve active：fav 恆保留；普通組別在新年度不存在 → fallback「全部」。
  function activeGroupFor(groups: string[], requested: string): string {
    if (requested === "fav") return "fav";
    return groups.includes(requested) ? requested : "全部";
  }
  function renderFilters(groups: string[], counts: Map<string, number>, activeGroup: string) {
    const wrap = document.getElementById("group-filters");
    if (!wrap) return;
    wrap.textContent = "";
    const favBtn = document.createElement("button");
    favBtn.className = "filter-btn";
    favBtn.dataset.group = "fav";
    favBtn.dataset.active = String(activeGroup === "fav");
    const favLabel = document.createElement("span");
    favLabel.className = "filter-label";
    favLabel.textContent = "我的收藏";
    const favCnt = document.createElement("span");
    favCnt.className = "filter-count tabular-nums";
    favCnt.id = "fav-count";
    favCnt.textContent = "0";
    favBtn.append(favLabel, favCnt);
    wrap.appendChild(favBtn);
    for (const g of groups) {
      const btn = document.createElement("button");
      btn.className = "filter-btn";
      btn.dataset.group = g;
      btn.dataset.active = String(g === activeGroup);
      const label = document.createElement("span");
      label.className = "filter-label";
      label.textContent = g;
      const cnt = document.createElement("span");
      cnt.className = "filter-count tabular-nums";
      cnt.textContent = String(counts.get(g) ?? 0);
      btn.append(label, cnt);
      wrap.appendChild(btn);
    }
  }

  function render(data: any) {
    if (!data) { current = null; return; }
    current = data;
    currentYear = data.year;
    if (yearSelect) yearSelect.value = String(data.year);
    if (brandYear) brandYear.textContent = String(data.year);
    // Rebuild group filters only when the year actually changed.
    if (lastRenderedYear !== data.year) {
      lastRenderedYear = data.year;
      const groups = ["全部", ...data.groups];
      // 年度切換保留目前 active；普通組別在新年度不存在 → fallback「全部」（fav 恆保留）。
      const active = activeGroupFor(groups, currentGroup());
      renderFilters(groups, groupCounts(data), active);
    }
    const favCount = document.getElementById("fav-count");
    if (favCount) favCount.textContent = String(currentYearFavCount(data));
    // scrapeLog notice: fixed container, toggled by data.
    if (scrapeLog && scrapeLogCount && scrapeLogList) {
      scrapeLogCount.textContent = String(data.scrapeLog.length);
      scrapeLogList.textContent = "";
      for (const err of data.scrapeLog) {
        const li = document.createElement("li");
        li.textContent = err;
        scrapeLogList.appendChild(li);
      }
      scrapeLog.hidden = data.scrapeLog.length === 0;
    }
    seriesCount.textContent = String(data.series.length);
    totalCount.textContent = String(data.series.length);
    // Re-anchor #updated-at to the newly loaded year's data; textContent is
    // set by humanizeAll (which reads data-ts and renders abs for this id).
    updatedAt.setAttribute("datetime", data.updatedAt);
    updatedAt.setAttribute("data-ts", data.updatedAt);
    const group = document.querySelector(".filter-btn[data-active='true']")?.getAttribute("data-group") ?? "全部";
    const sort = (document.getElementById("sort") as HTMLSelectElement)?.value ?? "dayCount";
    applyFilter(data, group, sort);
    humanizeAll();
  }

  function applyFilter(data: any, group: string, sort: string) {
    let series: any[] = data.series;
    if (group === "fav") {
      series = favSeries(data); // 收藏分頁：目前年度已收藏子集
    } else if (group !== "全部") {
      series = series.filter((s: any) => s.group === group);
    }
    series = series.filter((s: Series) => seriesMatchesQuery(s, query)); // 搜尋：組別 filter 之後、排序之前（spec §3.1）
    series = [...series].sort((a: any, b: any) => {
      if (sort === "views") return totalViews(b) - totalViews(a);
      if (sort === "latest") {
        const da = taipeiDay(lastPubIso(a)), db = taipeiDay(lastPubIso(b));
        if (!da && !db) return b.dayCount - a.dayCount; // 兩者皆無文章 → 進度
        if (!da) return 1;   // a 無文章 → 沉底
        if (!db) return -1;  // b 無文章 → 沉底
        const byDay = db.localeCompare(da); // 臺北日 desc
        if (byDay !== 0) return byDay;
        return latestPub(b) - latestPub(a); // 同日內按發文秒 desc
      }
      return b.dayCount - a.dayCount;
    });
    list.replaceChildren();
    if (group === "fav" && currentYearFavCount(data) === 0) {
      // 收藏分頁且搜尋前收藏數為 0（不可用搜尋後的 series.length——有收藏但被搜尋排除時會誤顯示）
      const empty = document.createElement("div");
      empty.className = "fav-empty";
      empty.id = "fav-empty";
      empty.setAttribute("role", "status");
      empty.setAttribute("aria-live", "polite");
      empty.tabIndex = -1;
      const p1 = document.createElement("p");
      p1.textContent = "尚未收藏任何系列";
      const p2 = document.createElement("p");
      p2.className = "fav-empty-hint";
      p2.textContent = "點卡片右上角星號開始追蹤你關心的系列。";
      empty.append(p1, p2);
      list.appendChild(empty);
    } else if (series.length === 0 && hasSearchTokens(query)) {
      // 搜尋無命中（含收藏有但被搜尋排除）；顯示中的空狀態不得帶 hidden（spec §2.3）
      const empty = document.createElement("div");
      empty.className = "search-empty";
      empty.id = "search-empty";
      empty.setAttribute("role", "status");
      empty.setAttribute("aria-live", "polite");
      empty.tabIndex = -1;
      const p1 = document.createElement("p");
      p1.textContent = `沒有符合「${searchInput.value}」的系列`; // raw query（textContent 組裝，XSS 安全）
      const p2 = document.createElement("p");
      p2.className = "search-empty-hint";
      p2.textContent = "試試其他關鍵字，或調整組別／排序。";
      empty.append(p1, p2);
      list.appendChild(empty);
    } else {
      const frag = document.createDocumentFragment();
      for (const s of series) frag.appendChild(viewMode === "list" ? renderRow(s) : renderCard(s));
      list.appendChild(frag);
    }
    shownCount.textContent = String(series.length);
    // 分母語意：收藏分頁 = 目前年度可顯示收藏數；一般分頁 = 年度全部系列數。
    totalCount.textContent = String(group === "fav" ? currentYearFavCount(data) : data.series.length);
    humanizeAll();
  }

  /* ---------- Grid card (matches SeriesCard.astro) ---------- */
  function renderCard(s: any) {
    const art = document.createElement("article");
    art.className = "series-card";
    const isDone = s.dayCount >= 30, isPending = s.dayCount === 0;
    const head = document.createElement("header");
    head.className = "card-head";
    const day = document.createElement("span");
    day.className = badgeClass(s); day.textContent = badgeText(s);
    const chipEl = chip(s);
    const headLeft = document.createElement("span");
    headLeft.className = "card-head-left";
    headLeft.append(day);
    if (chipEl) headLeft.append(chipEl);
    const right = document.createElement("div");
    right.className = "card-head-right";
    const stat = document.createElement("span");
    stat.className = "card-stat tabular-nums";
    stat.textContent = `${totalViews(s).toLocaleString()} 瀏覽`;
    const rss = document.createElement("button");
    rss.className = "card-action"; rss.type = "button";
    rss.dataset.rss = rssUrl(s); rss.dataset.title = s.title;
    rss.setAttribute("aria-label", "RSS 訂閱"); rss.title = "RSS 訂閱";
    rss.appendChild(RSS_ICON.cloneNode(true));
    const fav = document.createElement("button");
    fav.className = "card-action card-fav"; fav.type = "button";
    fav.dataset.favId = String(s.id);
    const isFav = favSet.has(s.id);
    fav.setAttribute("aria-pressed", String(isFav));
    fav.setAttribute("aria-label", isFav ? "取消收藏" : "收藏系列"); fav.title = isFav ? "取消收藏" : "收藏系列";
    fav.appendChild(FAV_ICON.cloneNode(true));
    right.append(fav, stat, rss); head.append(headLeft, right);

    const prog = document.createElement("div"); prog.className = "progress";
    const track = document.createElement("div"); track.className = "progress-track";
    const fill = document.createElement("div");
    fill.className = isDone ? "progress-fill progress-fill--done" : isPending ? "progress-fill progress-fill--pending" : "progress-fill";
    fill.style.width = `${Math.min((s.dayCount / 30) * 100, 100)}%`;
    track.appendChild(fill);
    const pl = document.createElement("span");
    pl.className = "progress-label tabular-nums"; pl.textContent = `${Math.min(s.dayCount, 30)}/30`;
    prog.append(track, pl);

    const h = document.createElement("h3"); h.className = "card-title";
    const a = document.createElement("a"); a.href = seriesUrl(s); a.target = "_blank"; a.rel = "noopener"; a.textContent = s.title;
    h.appendChild(a);

    const meta = document.createElement("p"); meta.className = "meta";
    const au = document.createElement("a"); au.className = "meta-author"; au.href = profileUrl(s); au.target = "_blank"; au.rel = "noopener"; au.textContent = s.user.name;
    meta.append(au, " · ", s.group, s.team ? ` · 團隊 ${s.team}` : "");

    const latest = s.articles[s.articles.length - 1];
    const lat = document.createElement(latest ? "div" : "p"); lat.className = "latest";
    if (latest) {
      const la = document.createElement("a"); la.className = "latest-link"; la.href = latest.url; la.target = "_blank"; la.rel = "noopener";
      const tag = document.createElement("span"); tag.className = "latest-tag"; tag.textContent = "最新";
      la.append(tag, latest.title);
      const lv = document.createElement("span"); lv.className = "latest-views tabular-nums";
      lv.appendChild(EYE_ICON.cloneNode(true));
      lv.appendChild(document.createTextNode(`${latest.views.toLocaleString()} 當篇觀看`));
      lat.append(la, lv);
    } else {
      const span = document.createElement("span"); span.className = "latest-link muted"; span.textContent = "尚未開賽";
      lat.appendChild(span);
    }

    art.append(head, prog, h, meta, lat);
    if (latest && latest.publishedAt) {
      const upd = document.createElement("p"); upd.className = "updated"; upd.textContent = "上次發布 ";
      const tm = document.createElement("time"); tm.dateTime = latest.publishedAt; tm.dataset.ts = latest.publishedAt;
      tm.textContent = latest.publishedAt.replace("T", " ").slice(0, 16);
      upd.appendChild(tm); art.appendChild(upd);
    }
    return art;
  }

  /* ---------- List row (compact) ---------- */
  function renderRow(s: any) {
    const row = document.createElement("article"); row.className = "series-row";
    const day = document.createElement("span"); day.className = badgeClass(s); day.textContent = badgeText(s);
    const chipEl = chip(s);
    const left = document.createElement("div"); left.className = "row-left";
    left.append(day);
    if (chipEl) left.append(chipEl);

    const main = document.createElement("div"); main.className = "row-main";
    const t = document.createElement("a"); t.className = "row-title"; t.href = seriesUrl(s); t.target = "_blank"; t.rel = "noopener"; t.textContent = s.title;
    const m = document.createElement("span"); m.className = "row-meta";
    const au = document.createElement("a"); au.className = "meta-author"; au.href = profileUrl(s); au.target = "_blank"; au.rel = "noopener"; au.textContent = s.user.name;
    m.append(au, " · ", s.group, s.team ? ` · 團隊 ${s.team}` : "");
    main.append(t, m);

    const views = document.createElement("span"); views.className = "row-views tabular-nums";
    views.appendChild(EYE_ICON.cloneNode(true));
    views.appendChild(document.createTextNode(totalViews(s).toLocaleString()));

    const actions = document.createElement("div"); actions.className = "row-actions";
    const rss = document.createElement("button"); rss.className = "card-action"; rss.type = "button";
    rss.dataset.rss = rssUrl(s); rss.dataset.title = s.title; rss.setAttribute("aria-label", "RSS 訂閱"); rss.title = "RSS 訂閱";
    rss.appendChild(RSS_ICON.cloneNode(true));
    const open = document.createElement("a"); open.className = "card-action"; open.href = seriesUrl(s); open.target = "_blank"; open.rel = "noopener";
    open.setAttribute("aria-label", "開啟系列"); open.title = "開啟系列"; open.appendChild(OPEN_ICON.cloneNode(true));
    const fav = document.createElement("button");
    fav.className = "card-action card-fav"; fav.type = "button";
    fav.dataset.favId = String(s.id);
    const isFav = favSet.has(s.id);
    fav.setAttribute("aria-pressed", String(isFav));
    fav.setAttribute("aria-label", isFav ? "取消收藏" : "收藏系列"); fav.title = isFav ? "取消收藏" : "收藏系列";
    fav.appendChild(FAV_ICON.cloneNode(true));
    actions.append(fav, rss, open);

    row.append(left, main, views, actions);
    return row;
  }

  /* ---------- Events ---------- */
  const groupFilters = document.getElementById("group-filters");
  groupFilters?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".filter-btn") as HTMLElement | null;
    if (!btn) return;
    groupFilters.querySelectorAll(".filter-btn").forEach((b) => b.setAttribute("data-active", "false"));
    btn.setAttribute("data-active", "true");
    if (current) applyFilter(current, btn.dataset.group!, (document.getElementById("sort") as HTMLSelectElement)?.value ?? "dayCount");
  });
  list.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".card-fav") as HTMLElement | null;
    if (!btn) return;
    e.preventDefault();
    const id = Number(btn.dataset.favId);
    // UI 層防禦（toggleFavorite 內亦 no-op，雙層守住邊界）。
    if (!isValidFavoriteId(id)) return;
    favSet = toggleFavorite(favSet, id);
    saveFavorites(storage, favSet);
    const nowFav = favSet.has(id);
    btn.setAttribute("aria-pressed", String(nowFav));
    btn.setAttribute("aria-label", nowFav ? "取消收藏" : "收藏系列"); btn.title = nowFav ? "取消收藏" : "收藏系列";
    btn.classList.remove("fav-pop"); void btn.offsetWidth; btn.classList.add("fav-pop");
    const favCount = document.getElementById("fav-count");
    if (favCount && current) favCount.textContent = String(currentYearFavCount(current));
    if (isFavView() && current) {
      // 收藏分頁：子集變了 → 重 render（取消收藏的卡片立即移出，空狀態由 applyFilter 重建）。
      applyFilter(current, "fav", (document.getElementById("sort") as HTMLSelectElement)?.value ?? "dayCount");
      // 移除最後一張收藏 → 卡片已不存在：焦點移至空狀態（已宣告），避免掉到 body。
      const emptied = list.querySelector(".series-card, .series-row") === null;
      if (emptied) {
        const emptyEl = document.getElementById("fav-empty");
        emptyEl?.focus();
      } else {
        // 仍有收藏：焦點還給同 id 的新卡片星號按鈕；該卡已被移除時退而聚焦列表首顆星。
        const nextFav = list.querySelector<HTMLElement>(`.card-fav[data-fav-id="${id}"]`)
          ?? list.querySelector<HTMLElement>(".card-fav");
        nextFav?.focus();
      }
    }
  });
  list.addEventListener("animationend", (e) => {
    const t = e.target as HTMLElement;
    if (t.classList?.contains("fav-pop")) t.classList.remove("fav-pop");
  });
  document.getElementById("sort")?.addEventListener("change", () => {
    if (current) applyFilter(current, (document.querySelector(".filter-btn[data-active='true']")?.getAttribute("data-group")) ?? "全部",
      (document.getElementById("sort") as HTMLSelectElement).value);
  });

  /* Search */
  const rssModal = document.getElementById("rss-modal");
  searchInput?.addEventListener("input", () => {
    query = searchInput.value;
    if (current) {
      const group = document.querySelector(".filter-btn[data-active='true']")?.getAttribute("data-group") ?? "全部";
      const sort = (document.getElementById("sort") as HTMLSelectElement)?.value ?? "dayCount";
      applyFilter(current, group, sort);
    }
  });
  searchInput?.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (rssModal?.classList.contains("open")) return; // modal 開啟：冒泡到 document 關 modal，不清空搜尋（spec §2.2）
    e.preventDefault(); // 取代 type="search" 原生 Escape 行為，避免雙重觸發
    searchInput.value = "";
    query = "";
    if (current) {
      const group = document.querySelector(".filter-btn[data-active='true']")?.getAttribute("data-group") ?? "全部";
      const sort = (document.getElementById("sort") as HTMLSelectElement)?.value ?? "dayCount";
      applyFilter(current, group, sort);
    }
    searchInput.focus(); // 焦點保留
  });

  /* View switcher */
  function setView(mode: "grid" | "list") {
    viewMode = mode;
    list.classList.toggle("view-list", mode === "list");
    document.getElementById("view-grid")?.setAttribute("aria-pressed", String(mode === "grid"));
    document.getElementById("view-list")?.setAttribute("aria-pressed", String(mode === "list"));
    try { if (mode === "grid") localStorage.removeItem("view"); else localStorage.setItem("view", "list"); } catch {}
    if (current) {
      const group = document.querySelector(".filter-btn[data-active='true']")?.getAttribute("data-group") ?? "全部";
      const sort = (document.getElementById("sort") as HTMLSelectElement)?.value ?? "dayCount";
      applyFilter(current, group, sort);
    }
  }
  document.getElementById("view-grid")?.addEventListener("click", () => setView("grid"));
  document.getElementById("view-list")?.addEventListener("click", () => setView("list"));
  try { if (localStorage.getItem("view") === "list") setView("list"); } catch {}

  /* RSS modal */
  const modal = document.getElementById("rss-modal")!;
  const modalSeries = document.getElementById("rss-modal-series")!;
  const urlInput = document.getElementById("rss-url-input") as HTMLInputElement;
  const rssOpen = document.getElementById("rss-open") as HTMLAnchorElement;
  const copyBtn = document.getElementById("rss-copy")!;
  function openRss(rss: string, title: string) {
    modalSeries.textContent = title;
    urlInput.value = rss;
    rssOpen.href = rss;
    modal.classList.add("open"); modal.setAttribute("aria-hidden", "false");
    urlInput.focus(); urlInput.select();
  }
  function closeRss() { modal.classList.remove("open"); modal.setAttribute("aria-hidden", "true"); copyBtn.textContent = "複製"; }
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const btn = t.closest("[data-rss]") as HTMLElement;
    if (btn) { e.preventDefault(); openRss(btn.dataset.rss!, btn.dataset.title!); return; }
    if (t.closest("[data-close]")) closeRss();
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeRss(); });
  copyBtn.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(urlInput.value); copyBtn.textContent = "已複製 ✓"; }
    catch { urlInput.focus(); urlInput.select(); copyBtn.textContent = "請手動複製"; }
  });

  /* Theme toggle: cycle auto → light → dark, persisted. */
  const themeToggle = document.getElementById("theme-toggle");
  const rootEl = document.documentElement;
  function currentTheme(): string { try { return localStorage.getItem("theme") ?? "auto"; } catch { return "auto"; } }
  themeToggle?.addEventListener("click", () => {
    const next = currentTheme() === "auto" ? "light" : currentTheme() === "light" ? "dark" : "auto";
    try { if (next === "auto") localStorage.removeItem("theme"); else localStorage.setItem("theme", next); } catch {}
    if (next === "auto") rootEl.removeAttribute("data-theme"); else rootEl.setAttribute("data-theme", next);
  });

  yearSelect?.addEventListener("change", () => {
    const y = Number(yearSelect.value);
    if (!Number.isInteger(y)) return;
    loadYear(y);
  });
  setInterval(() => { if (current) loadYear(currentYear); }, 60_000);

  // SSR 星號一律 aria-pressed="false"；首輪依 favSet 同步填色狀態（避免 FOUC）。
  document.querySelectorAll<HTMLElement>(".card-fav").forEach((b) => {
    const id = Number(b.dataset.favId);
    b.setAttribute("aria-pressed", String(favSet.has(id)));
  });
  render((window as any).IRONMAN_DATA);
  // Re-humanize periodically so relative times stay fresh (also re-anchors 臺北 today).
  setInterval(() => { today = taipeiToday(); humanizeAll(); }, 60000);
</script>
