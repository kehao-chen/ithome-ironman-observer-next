---
// web/src/components/SeriesCard.astro
import type { Series } from "../../../scripts/types";
interface Props { series: Series }
const { series: s } = Astro.props;
const latest = s.articles[s.articles.length - 1];
const totalViews = s.articles.reduce((n, a) => n + a.views, 0);
const isPending = s.dayCount === 0;
const isDone = s.dayCount >= 30;
const badgeClass = isDone ? "day-badge day-badge--done" : isPending ? "day-badge day-badge--pending" : "day-badge";
const badgeText = isPending ? "尚未開賽" : isDone ? "完賽" : `DAY ${s.dayCount}`;
const fillClass = isDone ? "progress-fill progress-fill--done" : isPending ? "progress-fill progress-fill--pending" : "progress-fill";
const pct = Math.min((s.dayCount / 30) * 100, 100);
const label = `${Math.min(s.dayCount, 30)}/30`;
---

<article class="series-card">
  <header class="card-head">
    <span class={badgeClass}>{badgeText}</span>
    <span class="card-stat tabular-nums">{totalViews} 瀏覽</span>
  </header>
  <div class="progress">
    <div class="progress-track"><div class={fillClass} style={`width:${pct}%`}></div></div>
    <span class="progress-label tabular-nums">{label}</span>
  </div>
  <h3 class="card-title"><a href={`https://ithelp.ithome.com.tw/users/${s.user.id}/ironman/${s.id}`} target="_blank" rel="noopener">{s.title}</a></h3>
  <p class="meta">{s.user.name} · {s.group}{s.team ? ` · 團隊 ${s.team}` : ""}</p>
  <p class="info">
    {latest
      ? <>最新 <a href={latest.url} target="_blank" rel="noopener">{latest.title}</a> · <span class="tabular-nums">{latest.views}</span> 當篇</>
      : <>尚未開賽</>}
  </p>
  {s.lastUpdated && (
    <p class="updated">更新 <time datetime={s.lastUpdated}>{s.lastUpdated}</time></p>
  )}
</article>
