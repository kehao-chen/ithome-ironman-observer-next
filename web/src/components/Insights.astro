---
// web/src/components/Insights.astro — Insights 分頁元件（ECharts 版）。
// 僅在 SSG 時計算 insight 文字句（lib/insights.ts）；圖表由 client-side ECharts 渲染。
import type { YearData } from "../../../scripts/types";
import {
  publishHourHistogram,
  viewsDistribution,
  groupStats,
  titleKeywordStats,
} from "../lib/insights";
import { DEFAULT_KEYWORDS } from "../lib/keywords";

interface Props {
  data: YearData;
  years: number[];
  latestYear: number;
}
const { data, years, latestYear } = Astro.props;

const articles = data.series.flatMap((s) => s.articles);
const articleCount = articles.length;
const hasSeries = data.series.length > 0;
const pageEmpty = data.year === 0;

// 1. 發文行為
const hour = publishHourHistogram(articles);
const peakHour = hour.reduce((a, b) => (b.count > a.count ? b : a), hour[0]);
const hourLine = pageEmpty
  ? "尚無資料"
  : articleCount === 0
    ? "尚無發文資料"
    : `${String(peakHour.hour).padStart(2, "0")} 時為發文高峰（${peakHour.count} 篇）`;

// 2. 人氣結構
const dist = viewsDistribution(articles);
const distLine = pageEmpty
  ? "尚無資料"
  : articleCount === 0
    ? "尚無觀看資料"
    : !dist.hasViews
      ? "尚無可計算的觀看資料"
      : `前 10% 文章佔總觀看 ${Math.round(dist.top10PctShare * 100)}%`;

// 3. 組別分析
const groups = groupStats(data.series);
const topGroup = groups[0];
const groupLine = pageEmpty
  ? "尚無資料"
  : !hasSeries
    ? "尚無組別資料"
    : `${topGroup.group} 最活躍（${topGroup.seriesCount} 系列）`;

// 4. 文字分析
const kws = titleKeywordStats(data.series, DEFAULT_KEYWORDS);
const topKw = kws[0];
const kwLine = pageEmpty
  ? "尚無資料"
  : !hasSeries
    ? "尚無標題關鍵字"
    : kws.length === 0
      ? "尚無標題關鍵字"
      : `${topKw.count} 個系列標題包含「${topKw.keyword}」`;
---

<header class="site-header container">
  <div class="header-row">
    <div class="brand">
      <a class="insights-back" href="/">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        鐵人觀察家
      </a>
      <h1 class="brand-title">Insights <span class="brand-year" id="brand-year">{latestYear || ""}</span></h1>
    </div>
    <div class="header-actions">
      <select id="insight-year-select" class="sort-select" aria-label="切換年度">
        {years.length > 0 && years.map((y) => <option value={y} selected={y === data.year}>{y} 年</option>)}
      </select>
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="切換明暗主題" title="切換明暗主題（自動 / 明 / 暗）">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>
    </div>
  </div>
</header>

<main class="container insights-main">

  <section class="insight-panel">
    <div class="insight-panel-head">
      <div>
        <h2 class="insight-title">發文行為</h2>
        <p class="insight-line" id="insight-hour-line">{hourLine}</p>
      </div>
      <span class="insight-panel-index">01</span>
    </div>
    <div class="insight-charts">
      <div class="insight-chart">
        <h3>發文時間</h3>
        <div id="chart-hour" class="chart-canvas is-loading"></div>
      </div>
      <div class="insight-chart">
        <h3>賽程進度</h3>
        <div id="chart-daycount" class="chart-canvas is-loading"></div>
      </div>
    </div>
  </section>

  <section class="insight-panel">
    <div class="insight-panel-head">
      <div>
        <h2 class="insight-title">人氣結構</h2>
        <p class="insight-line" id="insight-dist-line">{distLine}</p>
      </div>
      <span class="insight-panel-index">02</span>
    </div>
    <div class="insight-charts">
      <div class="insight-chart">
        <h3>文章觀看分佈</h3>
        <div id="chart-dist" class="chart-canvas is-loading"></div>
      </div>
      <div class="insight-chart insight-chart--subs">
        <h3>訂閱數排行</h3>
        <div id="chart-subs" class="chart-canvas is-loading"></div>
      </div>
    </div>
  </section>

  <section class="insight-panel">
    <div class="insight-panel-head">
      <div>
        <h2 class="insight-title">組別分析</h2>
        <p class="insight-line" id="insight-group-line">{groupLine}</p>
      </div>
      <span class="insight-panel-index">03</span>
    </div>
    <div class="insight-charts">
      <div class="insight-chart insight-chart--wide">
        <h3>發文量與平均觀看</h3>
        <div id="chart-scatter" class="chart-canvas is-loading"></div>
      </div>
    </div>
  </section>

  <section class="insight-panel">
    <div class="insight-panel-head">
      <div>
        <h2 class="insight-title">文字分析</h2>
        <p class="insight-line" id="insight-kw-line">{kwLine}</p>
      </div>
      <span class="insight-panel-index">04</span>
    </div>
    <div class="insight-charts">
      <div class="insight-chart">
        <h3>標題關鍵字</h3>
        <div id="chart-kw" class="chart-canvas is-loading"></div>
      </div>
      <div class="insight-chart">
        <h3>標題字數</h3>
        <div id="chart-len" class="chart-canvas is-loading"></div>
      </div>
    </div>
  </section>

</main>

<script is:inline define:vars={{ initialData: data, yearsList: years }}>
  window.INSIGHTS_DATA = initialData;
  window.INSIGHTS_YEARS = yearsList;
</script>
<script is:inline>
  /* Theme toggle: cycle auto → light → dark（與 Dashboard.astro 同 handler）。 */
  const themeToggle = document.getElementById("theme-toggle");
  const rootEl = document.documentElement;
  function currentTheme() { try { return localStorage.getItem("theme") ?? "auto"; } catch { return "auto"; } }
  themeToggle?.addEventListener("click", () => {
    const next = currentTheme() === "auto" ? "light" : currentTheme() === "light" ? "dark" : "auto";
    try { if (next === "auto") localStorage.removeItem("theme"); else localStorage.setItem("theme", next); } catch {}
    if (next === "auto") rootEl.removeAttribute("data-theme"); else rootEl.setAttribute("data-theme", next);
  });
</script>

<style is:global>
  @import "../styles/insights.css";
</style>
