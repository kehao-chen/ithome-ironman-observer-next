---
// web/src/pages/index.astro
import Dashboard from "../components/Dashboard.astro";
import type { MetaJson, YearData } from "../../../scripts/types";
import designSystemCss from "../styles/design-system.css?inline";

const dataByYear = new Map<number, YearData>();
for (const [path, mod] of Object.entries(import.meta.glob(["../../../data/*.json", "!../../../data/meta.json"], { eager: true, import: "default" }))) {
  const m = path.match(/(\d{4})\.json$/);
  if (m) dataByYear.set(Number(m[1]), mod as YearData);
}
const meta = (await import("../../../data/meta.json").then((m) => m.default)) as MetaJson;// Authority: meta.years ∩ actually-present data files (defensive against stale meta).
const years = meta.years.filter((y) => dataByYear.has(y)).sort((a, b) => b - a);
// latestYear 正規化為 number（0 = 無可用年度）；避免 number | undefined（review #4b）。
const latestYear = years[0] ?? [...dataByYear.keys()].sort((a, b) => b - a)[0] ?? 0;
// 空資料 fallback：完全沒有可用 YearData 時不 crash，Dashboard 顯示空狀態（spec §6、review #4）。
const emptyData: YearData = { year: 0, updatedAt: "", groups: [], series: [], scrapeLog: [] };
const data: YearData = latestYear !== 0 && dataByYear.has(latestYear) ? dataByYear.get(latestYear)! : emptyData;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>鐵人觀察家 Next</title>
  <meta name="description" content={`${latestYear} iThome 鐵人賽每日觀察：追蹤每支參賽系列的進度與人氣`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://ithelp.ithome.com.tw" />
  <link rel="dns-prefetch" href="https://ithelp.ithome.com.tw" />
  <style is:inline set:html={designSystemCss} />
  <script is:inline>
    // Theme: auto (prefers-color-scheme) + manual toggle, persisted in localStorage.
    (function () {
      var stored = null;
      try { stored = localStorage.getItem("theme"); } catch (e) {}
      var root = document.documentElement;
      if (stored === "light" || stored === "dark") {
        root.setAttribute("data-theme", stored);
      } else {
        root.removeAttribute("data-theme"); // let prefers-color-scheme decide
      }
    })();
  </script>
</head>
<body>
  <!--
    鐵人觀察家 2026 — Direction Contract（權威：DESIGN.md「賽事觀察板」）
    THESIS: 每支參賽系列是一筆賽事紀錄：DAY n/30 進度條 = 跑完多少，總瀏覽 = 分數，
      最新文章 = 今天交了什麼。這是給技術讀者掃讀的計分板，不是被裝飾的藝術品。
    OWN-WORLD: 沉穩藍單一 accent（dark #3b82f6 / light #2563eb）on 中性底；
      綠 = 完賽、琥珀 = 尚未開賽；flat panels（1px hairline + tonal layering），
      hover 浮起 + accent 描邊；tabular-nums 計分板數字；卡片單欄垂直堆疊。
    MODE: Operate — 掃讀效率與資料密度最高指導，brand 活在精準細節。
    THEME: dark 預設 + light；prefers-color-scheme 自動 + manual toggle 持久化（data-theme）。
    CONTRACT: 保留此 comment 於 build 後 markup（禁 innerHTML 放使用者資料；textContent only）。
  -->
  <Dashboard data={data} years={years} />
</body>
</html>
