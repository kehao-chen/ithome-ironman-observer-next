---
// web/src/pages/insights.astro — Insights 分析分頁（SSG 最新年度 + client 年切換）。
import Insights from "../components/Insights.astro";
import type { MetaJson, YearData } from "../../../scripts/types";

const dataByYear = new Map<number, YearData>();
for (const [path, mod] of Object.entries(import.meta.glob(["../../../data/*.json", "!../../../data/meta.json"], { eager: true, import: "default" }))) {
  const m = path.match(/(\d{4})\.json$/);
  if (m) dataByYear.set(Number(m[1]), mod as YearData);
}
const meta = (await import("../../../data/meta.json").then((m) => m.default)) as MetaJson;
const years = meta.years.filter((y) => dataByYear.has(y)).sort((a, b) => b - a);
const latestYear =
  years[0] ??
  [...dataByYear.keys()].sort((a, b) => b - a)[0] ??
  0;
const emptyData: YearData = { year: 0, updatedAt: "", groups: [], series: [], scrapeLog: [] };
const data: YearData = latestYear !== 0 && dataByYear.has(latestYear) ? dataByYear.get(latestYear)! : emptyData;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>鐵人觀察家 Insights {latestYear || ""}</title>
  <meta name="description" content={`${latestYear || ""} iThome 鐵人賽 Insights 分析：發文行為、人氣結構、組別分析與標題文字分析`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <style is:global>
    @import "../styles/design-system.css";
  </style>
  <script is:inline>
    // Theme: auto (prefers-color-scheme) + manual toggle, persisted in localStorage.
    (function () {
      var stored = null;
      try { stored = localStorage.getItem("theme"); } catch (e) {}
      var root = document.documentElement;
      if (stored === "light" || stored === "dark") {
        root.setAttribute("data-theme", stored);
      } else {
        root.removeAttribute("data-theme");
      }
    })();
  </script>
</head>
<body>
  <Insights data={data} years={years} latestYear={latestYear} />
  <div id="insight-toast" class="insight-toast" role="status" aria-live="polite">年度資料載入失敗</div>

  <script>
    import * as echarts from "echarts/core";
    import { BarChart, LineChart, ScatterChart } from "echarts/charts";
    import { GridComponent, TooltipComponent } from "echarts/components";
    import { CanvasRenderer } from "echarts/renderers";
    import {
      publishHourHistogram,
      viewsDistribution,
      viewsPercentiles,
      topSeriesBySubscriptions,
      groupStats,
      titleKeywordStats,
      titleLengthDistribution,
      dayCountDistribution,
    } from "../lib/insights";
    import { DEFAULT_KEYWORDS } from "../lib/keywords";
    import type { YearData } from "../../../scripts/types";

    echarts.use([BarChart, LineChart, ScatterChart, GridComponent, TooltipComponent, CanvasRenderer]);

    // ── State ──────────────────────────────────────────────────────────────
    const initialData = (window as any).INSIGHTS_DATA as YearData;
    const yearsList = (window as any).INSIGHTS_YEARS as number[];
    let fetchToken = 0;
    let currentYear = initialData.year;
    let currentData: YearData = initialData;
    const chartInstances = new Map<string, echarts.ECharts>();

    // ── Validation ─────────────────────────────────────────────────────────
    function isYearData(value: unknown): value is YearData {
      return Boolean(
        value &&
          typeof value === "object" &&
          typeof (value as YearData).year === "number" &&
          Array.isArray((value as YearData).series),
      );
    }

    // ── Toast ──────────────────────────────────────────────────────────────
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function showToast() {
      const el = document.getElementById("insight-toast");
      if (!el) return;
      el.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove("show"), 2200);
    }

    // ── Color tokens (re-read on each render for theme support) ────────────
    function getColors() {
      const s = getComputedStyle(document.documentElement);
      const v = (n: string) => s.getPropertyValue(n).trim();
      return {
        accent:      v("--accent"),
        success:     v("--success"),
        warning:     v("--warning"),
        muted:       v("--muted"),
        text:        v("--text"),
        border:      v("--border"),
        surfaceMuted: v("--surface-muted"),
      };
    }

    function axisBase(c: ReturnType<typeof getColors>) {
      return {
        axisLine:  { lineStyle: { color: c.border } },
        axisTick:  { show: false },
        axisLabel: { color: c.muted, fontSize: 11, fontFamily: "inherit" },
        splitLine: { lineStyle: { color: c.border, type: "dashed" as const } },
      };
    }

    function tooltip(c: ReturnType<typeof getColors>, extra?: object) {
      return {
        trigger: "axis" as const,
        backgroundColor: c.surfaceMuted,
        borderColor: c.border,
        textStyle: { color: c.text, fontSize: 12 },
        ...extra,
      };
    }

    // ── Chart init / get ───────────────────────────────────────────────────
    function getChart(id: string): echarts.ECharts | null {
      const el = document.getElementById(id);
      if (!el) return null;
      let inst = chartInstances.get(id);
      if (!inst) {
        inst = echarts.init(el, null, { renderer: "canvas" });
        chartInstances.set(id, inst);
      }
      return inst;
    }

    function disposeAll() {
      chartInstances.forEach((inst) => inst.dispose());
      chartInstances.clear();
    }

    function setLoadingState(loading: boolean) {
      document.querySelectorAll<HTMLElement>(".chart-canvas").forEach((el) => {
        el.classList.toggle("is-loading", loading);
      });
    }

    // ── Render all charts ──────────────────────────────────────────────────
    function renderCharts(d: YearData) {
      const arts = d.series.flatMap((s) => s.articles);
      const hasSeries = d.series.length > 0;
      const hasArts = arts.length > 0;
      const c = getColors();
      const ax = axisBase(c);

      const grid = (extra?: object) => ({
        top: 12, right: 12, bottom: 24, left: 12, containLabel: true, ...extra,
      });

      // 1. 發文時間（bar）
      {
        const hour = publishHourHistogram(arts);
        const inst = getChart("chart-hour");
        inst?.setOption({
          backgroundColor: "transparent",
          grid: grid(),
          tooltip: tooltip(c),
          xAxis: {
            type: "category",
            data: hour.map((h) => String(h.hour).padStart(2, "0")),
            ...ax,
            axisLabel: { ...ax.axisLabel, interval: 3 },
          },
          yAxis: { type: "value", ...ax },
          series: [{
            type: "bar",
            data: hasArts ? hour.map((h) => h.count) : [],
            itemStyle: { color: c.accent, borderRadius: [2, 2, 0, 0] },
          }],
        }, true);
      }

      // 2. 賽程進度（bar，dayCount 分六桶）
      {
        const dayDist = dayCountDistribution(d.series);
        // 漸層色：早期棄賽橘→後期完賽綠
        const barColors = [c.warning, c.warning, c.muted, c.muted, c.success, c.success];
        const inst = getChart("chart-daycount");
        inst?.setOption({
          backgroundColor: "transparent",
          grid: grid(),
          tooltip: {
            ...tooltip(c),
            formatter: (params: any) =>
              `第 ${params[0].axisValue} 天：${params[0].value} 系列`,
          },
          xAxis: { type: "category", data: dayDist.map((b) => b.label), ...ax },
          yAxis: { type: "value", ...ax },
          series: [{
            type: "bar",
            data: hasSeries ? dayDist.map((b, i) => ({
              value: b.count,
              itemStyle: { color: barColors[i] ?? c.accent, borderRadius: [2, 2, 0, 0] },
            })) : [],
          }],
        }, true);
      }

      // 3. 文章觀看 CDF（line area）
      {
        const percs = viewsPercentiles(arts);
        const inst = getChart("chart-dist");
        inst?.setOption({
          backgroundColor: "transparent",
          grid: grid(),
          tooltip: {
            ...tooltip(c),
            trigger: "axis" as const,
            formatter: (params: any) =>
              `第 ${params[0].data[0]}% 百分位<br/>觀看數 ≤ <b>${Number(params[0].data[1]).toLocaleString()}</b>`,
          },
          xAxis: {
            type: "value", min: 0, max: 100, ...ax,
            axisLabel: { ...ax.axisLabel, formatter: (v: number) => `${v}%` },
          },
          yAxis: { type: "value", ...ax },
          series: [{
            type: "line",
            data: hasArts ? percs.map((p) => [p.pct, p.views]) : [],
            smooth: 0.35,
            symbol: "none",
            lineStyle: { color: c.accent, width: 2 },
            areaStyle: {
              color: {
                type: "linear", x: 0, y: 0, x2: 0, y2: 1,
                colorStops: [
                  { offset: 0, color: c.accent + "44" },
                  { offset: 1, color: c.accent + "00" },
                ],
              },
            },
          }],
        }, true);
      }

      // 4. 訂閱數排行（horizontal bar）
      {
        const subs = topSeriesBySubscriptions(d.series);
        const inst = getChart("chart-subs");
        inst?.setOption({
          backgroundColor: "transparent",
          grid: { top: 12, right: 16, bottom: 12, left: 12, containLabel: true },
          tooltip: { ...tooltip(c), trigger: "item" as const },
          xAxis: { type: "value", ...ax },
          yAxis: {
            type: "category",
            data: hasSeries ? subs.map((s) => s.name) : [],
            inverse: true,
            ...ax,
            axisLabel: { ...ax.axisLabel, width: 130, overflow: "truncate" },
          },
          series: [{
            type: "bar",
            data: hasSeries ? subs.map((s) => s.subscriptions) : [],
            itemStyle: { color: c.success, borderRadius: [0, 2, 2, 0] },
          }],
        }, true);
      }

      // 5. 組別 scatter（發文量 × 平均觀看）
      {
        const grps = groupStats(d.series);
        const inst = getChart("chart-scatter");
        inst?.setOption({
          backgroundColor: "transparent",
          grid: { top: 16, right: 16, bottom: 28, left: 12, containLabel: true },
          tooltip: {
            trigger: "item" as const,
            backgroundColor: c.surfaceMuted,
            borderColor: c.border,
            textStyle: { color: c.text, fontSize: 12 },
            formatter: (_p: any, _t: any, idx: number) => {
              const g = grps[idx];
              return g
                ? `${g.group}<br/>${g.seriesCount} 系列 / ${g.articleCount} 文 / 平均 ${g.avgViews} 觀看`
                : "";
            },
          },
          xAxis: { type: "value", name: "文章數", nameTextStyle: { color: c.muted, fontSize: 11 }, ...ax },
          yAxis: { type: "value", name: "平均觀看", nameTextStyle: { color: c.muted, fontSize: 11 }, ...ax },
          series: [{
            type: "scatter",
            data: hasSeries ? grps.map((g) => [g.articleCount, g.avgViews, g.seriesCount]) : [],
            symbolSize: (d: number[]) => Math.max(8, Math.min(42, (d[2] ?? 1) * 1.8)),
            itemStyle: { color: c.accent, opacity: 0.75 },
          }],
        }, true);
      }

      // 6. 標題關鍵字（bar）
      {
        const kws = titleKeywordStats(d.series, DEFAULT_KEYWORDS);
        const inst = getChart("chart-kw");
        inst?.setOption({
          backgroundColor: "transparent",
          grid: grid(),
          tooltip: tooltip(c),
          xAxis: {
            type: "category",
            data: kws.map((k) => k.keyword),
            ...ax,
            axisLabel: { ...ax.axisLabel, rotate: kws.length > 8 ? 30 : 0 },
          },
          yAxis: { type: "value", ...ax },
          series: [{
            type: "bar",
            data: kws.map((k) => k.count),
            itemStyle: { color: c.warning, borderRadius: [2, 2, 0, 0] },
          }],
        }, true);
      }

      // 7. 標題字數（bar）
      {
        const lenDist = titleLengthDistribution(d.series);
        const inst = getChart("chart-len");
        inst?.setOption({
          backgroundColor: "transparent",
          grid: grid(),
          tooltip: tooltip(c),
          xAxis: { type: "category", data: lenDist.map((b) => b.length), ...ax },
          yAxis: { type: "value", ...ax },
          series: [{
            type: "bar",
            data: hasSeries ? lenDist.map((b) => b.count) : [],
            itemStyle: { color: c.muted, borderRadius: [2, 2, 0, 0] },
          }],
        }, true);
      }

      setLoadingState(false);
    }

    // ── Text helpers ───────────────────────────────────────────────────────
    function setText(id: string, text: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function renderText(d: YearData) {
      const arts = d.series.flatMap((s) => s.articles);
      const hasSeries = d.series.length > 0;

      if (d.year === 0) {
        for (const id of ["insight-hour-line", "insight-dist-line", "insight-group-line", "insight-kw-line"])
          setText(id, "尚無資料");
        return;
      }

      // 1. 發文行為
      if (arts.length === 0) {
        setText("insight-hour-line", "尚無發文資料");
      } else {
        const hour = publishHourHistogram(arts);
        const peak = hour.reduce((a, b) => (b.count > a.count ? b : a), hour[0]);
        setText("insight-hour-line", `${String(peak.hour).padStart(2, "0")} 時為發文高峰（${peak.count} 篇）`);
      }

      // 2. 人氣結構
      if (arts.length === 0) {
        setText("insight-dist-line", "尚無觀看資料");
      } else {
        const dist = viewsDistribution(arts);
        setText(
          "insight-dist-line",
          !dist.hasViews
            ? "尚無可計算的觀看資料"
            : `前 10% 文章佔總觀看 ${Math.round(dist.top10PctShare * 100)}%`,
        );
      }

      // 3. 組別
      if (!hasSeries) {
        setText("insight-group-line", "尚無組別資料");
      } else {
        const grps = groupStats(d.series);
        setText("insight-group-line", `${grps[0].group} 最活躍（${grps[0].seriesCount} 系列）`);
      }

      // 4. 文字
      if (!hasSeries) {
        setText("insight-kw-line", "尚無標題關鍵字");
      } else {
        const kws = titleKeywordStats(d.series, DEFAULT_KEYWORDS);
        setText(
          "insight-kw-line",
          kws.length === 0
            ? "尚無標題關鍵字"
            : `${kws[0].count} 個系列標題包含「${kws[0].keyword}」`,
        );
      }
    }

    // ── Full render ────────────────────────────────────────────────────────
    function render(d: YearData) {
      currentYear = d.year;
      currentData = d;
      renderText(d);
      renderCharts(d);
      const sel = document.getElementById("insight-year-select") as HTMLSelectElement | null;
      if (sel) sel.value = String(d.year);
      const brandYear = document.getElementById("brand-year");
      if (brandYear) brandYear.textContent = d.year ? String(d.year) : "";
    }

    // ── Fetch year ─────────────────────────────────────────────────────────
    function fetchYear(year: number) {
      const token = ++fetchToken;
      const sel = document.getElementById("insight-year-select") as HTMLSelectElement | null;
      setLoadingState(true);
      fetch(`/data/${year}.json?t=${Date.now()}`, { cache: "no-store" })
        .then((res) => (res.ok ? res.json() : Promise.reject(new Error(`HTTP ${res.status}`))))
        .then((fresh) => {
          if (token !== fetchToken) return null;
          if (!isYearData(fresh)) throw new Error("invalid year data");
          return fresh;
        })
        .then((fresh) => {
          if (!fresh || token !== fetchToken) return;
          render(fresh);
          history.replaceState(null, "", `?year=${fresh.year}`);
        })
        .catch(() => {
          if (token !== fetchToken) return;
          if (sel) sel.value = String(currentYear);
          setLoadingState(false);
          showToast();
        });
    }

    // ── Theme re-render ────────────────────────────────────────────────────
    new MutationObserver(() => {
      disposeAll();
      setLoadingState(true);
      // rAF: let the new CSS vars settle before reading them
      requestAnimationFrame(() => renderCharts(currentData));
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    // ── Resize ────────────────────────────────────────────────────────────
    window.addEventListener("resize", () => {
      chartInstances.forEach((inst) => inst.resize());
    });

    // ── Year select ───────────────────────────────────────────────────────
    document.getElementById("insight-year-select")?.addEventListener("change", (e) => {
      const y = Number((e.target as HTMLSelectElement).value);
      if (Number.isInteger(y) && y !== 0) fetchYear(y);
    });

    // ── Init ──────────────────────────────────────────────────────────────
    const q = new URLSearchParams(location.search).get("year");
    const initYear = yearsList.includes(Number(q)) ? Number(q) : initialData.year;
    if (initYear !== initialData.year && initYear !== 0) {
      fetchYear(initYear);
    } else {
      render(initialData);
      if (initialData.year !== 0) history.replaceState(null, "", `?year=${initialData.year}`);
    }
  </script>
</body>
</html>
