---
// web/src/pages/insights.astro — Insights 分析分頁（SSG 最新年度 + client 年切換）。
import Insights from "../components/Insights.astro";
import type { MetaJson, YearData } from "../../../scripts/types";
import designSystemCss from "../styles/design-system.css?inline";
import insightsCss from "../styles/insights.css?inline";

const dataByYear = new Map<number, YearData>();
for (const [path, mod] of Object.entries(import.meta.glob(["../../../data/*.json", "!../../../data/meta.json"], { eager: true, import: "default" }))) {
  const m = path.match(/(\d{4})\.json$/);
  if (m) dataByYear.set(Number(m[1]), mod as YearData);
}
const meta = (await import("../../../data/meta.json").then((m) => m.default)) as MetaJson;
const years = meta.years.filter((y) => dataByYear.has(y)).sort((a, b) => b - a);
const latestYear =
  years[0] ??
  [...dataByYear.keys()].sort((a, b) => b - a)[0] ??
  0;
const emptyData: YearData = { year: 0, updatedAt: "", groups: [], series: [], scrapeLog: [] };
const data: YearData = latestYear !== 0 && dataByYear.has(latestYear) ? dataByYear.get(latestYear)! : emptyData;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>鐵人觀察家 Next — Insights</title>
  <meta name="description" content={`${latestYear || ""} iThome 鐵人賽 Insights 分析：發文行為、組別生態、文字分析與斷更觀察`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://ithelp.ithome.com.tw" />
  <link rel="dns-prefetch" href="https://ithelp.ithome.com.tw" />
  <style is:inline set:html={designSystemCss + "\n" + insightsCss} />
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem("theme"); } catch (e) {}
      var root = document.documentElement;
      if (stored === "light" || stored === "dark") {
        root.setAttribute("data-theme", stored);
      } else {
        root.removeAttribute("data-theme");
      }
    })();
  </script>
</head>
<body>
  <Insights data={data} years={years} latestYear={latestYear} />
  <div id="insight-toast" class="insight-toast" role="status" aria-live="polite">年度資料載入失敗</div>

  <script>
    import * as echarts from "echarts/core";
    import { BarChart, LineChart, HeatmapChart } from "echarts/charts";
    import { GridComponent, TooltipComponent, VisualMapComponent, LegendComponent } from "echarts/components";
    import { CanvasRenderer } from "echarts/renderers";
    import {
      publishHourHistogram,
      groupStats,
      titleKeywordStats,
      titleLengthDistribution,
      dayCountDistribution,
      publishHeatmap,
      staleObservation,
      staleDayDistribution,
    } from "../lib/insights";
    import { DEFAULT_KEYWORDS } from "../lib/keywords";
    import { taipeiToday } from "../lib/daily-status";
    import type { YearData } from "../../../scripts/types";

    echarts.use([BarChart, LineChart, HeatmapChart, GridComponent, TooltipComponent, VisualMapComponent, LegendComponent, CanvasRenderer]);
    // ── State ──────────────────────────────────────────────────────────────
    const initialData = (window as any).INSIGHTS_DATA as YearData;
    const yearsList = (window as any).INSIGHTS_YEARS as number[];
    let fetchToken = 0;
    let currentYear = initialData.year;
    let currentData: YearData = initialData;
    const chartInstances = new Map<string, echarts.ECharts>();

    // ── Validation ─────────────────────────────────────────────────────────
    function isYearData(value: unknown): value is YearData {
      return Boolean(
        value &&
          typeof value === "object" &&
          typeof (value as YearData).year === "number" &&
          Array.isArray((value as YearData).series),
      );
    }

    // ── Toast ──────────────────────────────────────────────────────────────
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function showToast() {
      const el = document.getElementById("insight-toast");
      if (!el) return;
      el.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove("show"), 2200);
    }

    // ── Color tokens ───────────────────────────────────────────────────────
    function getColors() {
      const s = getComputedStyle(document.documentElement);
      const v = (n: string) => s.getPropertyValue(n).trim();
      return {
        accent:       v("--accent"),
        success:      v("--success"),
        warning:      v("--warning"),
        muted:        v("--muted"),
        text:         v("--text"),
        border:       v("--border"),
        surfaceMuted: v("--surface-muted"),
        danger:       v("--danger"),
      };
    }

    function axisBase(c: ReturnType<typeof getColors>) {
      return {
        axisLine:  { lineStyle: { color: c.border } },
        axisTick:  { show: false },
        axisLabel: { color: c.muted, fontSize: 11, fontFamily: "inherit" },
        splitLine: { lineStyle: { color: c.border, type: "dashed" as const } },
      };
    }

    function tip(c: ReturnType<typeof getColors>, extra?: object) {
      return {
        backgroundColor: c.surfaceMuted,
        borderColor: c.border,
        textStyle: { color: c.text, fontSize: 12 },
        ...extra,
      };
    }

    // ── Chart lifecycle ────────────────────────────────────────────────────
    function getChart(id: string): echarts.ECharts | null {
      const el = document.getElementById(id);
      if (!el) return null;
      let inst = chartInstances.get(id);
      if (!inst) {
        inst = echarts.init(el, null, { renderer: "canvas" });
        chartInstances.set(id, inst);
      }
      return inst;
    }

    function disposeAll() {
      chartInstances.forEach((inst) => inst.dispose());
      chartInstances.clear();
    }

    function setLoadingState(loading: boolean) {
      document.querySelectorAll<HTMLElement>(".chart-canvas").forEach((el) => {
        el.classList.toggle("is-loading", loading);
      });
    }

    // ── Percentile helper ──────────────────────────────────────────────────
    function keyPercentiles(views: number[]): { label: string; pct: number; value: number }[] {
      if (views.length === 0) return [];
      const sorted = [...views].sort((a, b) => a - b);
      const n = sorted.length;
      const p = (pct: number) => sorted[Math.min(Math.floor((pct / 100) * n), n - 1)];
      return [
        { label: "p25",      pct: 25, value: p(25) },
        { label: "中位數",   pct: 50, value: p(50) },
        { label: "p75",      pct: 75, value: p(75) },
        { label: "p90",      pct: 90, value: p(90) },
        { label: "p95",      pct: 95, value: p(95) },
        { label: "p99",      pct: 99, value: p(99) },
      ];
    }

    // ── Render charts ──────────────────────────────────────────────────────
    function renderCharts(d: YearData) {
      const arts = d.series.flatMap((s) => s.articles);
      const hasSeries = d.series.length > 0;
      const hasArts = arts.length > 0;
      const c = getColors();
      const ax = axisBase(c);
      const grid = (extra?: object) => ({ top: 12, right: 12, bottom: 24, left: 12, containLabel: true, ...extra });

      // 1. 發文時間 ─────────────────────────────────────────────────────────
      {
        const hour = publishHourHistogram(arts);
        getChart("chart-hour")?.setOption({
          backgroundColor: "transparent",
          grid: grid(),
          tooltip: { trigger: "axis", ...tip(c) },
          xAxis: { type: "category", data: hour.map((h) => String(h.hour).padStart(2, "0")), ...ax, axisLabel: { ...ax.axisLabel, interval: 3 } },
          yAxis: { type: "value", ...ax },
          series: [{ type: "bar", data: hasArts ? hour.map((h) => h.count) : [], itemStyle: { color: c.accent, borderRadius: [2, 2, 0, 0] } }],
        }, true);
      }

      // 2. 賽程進度 ─────────────────────────────────────────────────────────
      {
        const dayDist = dayCountDistribution(d.series);
        const barColors = [c.warning, c.warning, c.muted, c.muted, c.success, c.success];
        getChart("chart-daycount")?.setOption({
          backgroundColor: "transparent",
          grid: grid(),
          tooltip: { trigger: "axis", ...tip(c), formatter: (p: any) => `第 ${p[0].axisValue} 天：${p[0].value} 系列` },
          xAxis: { type: "category", data: dayDist.map((b) => b.label), ...ax },
          yAxis: { type: "value", ...ax },
          series: [{
            type: "bar",
            data: hasSeries ? dayDist.map((b, i) => ({ value: b.count, itemStyle: { color: barColors[i] ?? c.accent, borderRadius: [2, 2, 0, 0] } })) : [],
          }],
        }, true);
      }

      // 3. 各組別系列數與發文量：horizontal grouped bar ───────────────────────
      {
        const grps = groupStats(d.series);
        const groupEl = document.getElementById("chart-group");
        if (groupEl && grps.length > 0) groupEl.style.height = `${grps.length * 30 + 50}px`;
        getChart("chart-group")?.setOption({
          backgroundColor: "transparent",
          grid: { top: 32, right: 32, bottom: 12, left: 12, containLabel: true },
          legend: { data: ["系列數", "發文篇數"], textStyle: { color: c.muted, fontSize: 11 }, top: 0, right: 12 },
          tooltip: {
            trigger: "axis",
            axisPointer: { type: "shadow" },
            ...tip(c),
            formatter: (params: any) => {
              const g = grps[params[0]?.dataIndex];
              return g
                ? `<b>${g.group}</b><br/>系列數：${g.seriesCount}<br/>累計發文：${g.articleCount} 篇`
                : "";
            },
          },
          xAxis: { type: "value", ...ax },
          yAxis: {
            type: "category",
            data: hasSeries ? grps.map((g) => g.group) : [],
            inverse: true,
            ...ax,
            axisLabel: { ...ax.axisLabel, width: 140, overflow: "truncate" },
          },
          series: [
            {
              name: "系列數",
              type: "bar",
              data: hasSeries ? grps.map((g) => g.seriesCount) : [],
              itemStyle: { color: c.accent, borderRadius: [0, 2, 2, 0] },
            },
            {
              name: "發文篇數",
              type: "bar",
              data: hasSeries ? grps.map((g) => g.articleCount) : [],
              itemStyle: { color: c.success, borderRadius: [0, 2, 2, 0] },
            },
          ],
        }, true);
      }

      // 6. 標題關鍵字：horizontal bar（標籤橫列，易讀）──────────────────────
      {
        const kws = titleKeywordStats(d.series, DEFAULT_KEYWORDS);
        const kwEl = document.getElementById("chart-kw");
        if (kwEl && kws.length > 0) kwEl.style.height = `${kws.length * 28 + 24}px`;
        getChart("chart-kw")?.setOption({
          backgroundColor: "transparent",
          grid: { top: 12, right: 48, bottom: 12, left: 12, containLabel: true },
          tooltip: { trigger: "item", ...tip(c) },
          xAxis: { type: "value", ...ax },
          yAxis: {
            type: "category",
            data: kws.map((k) => k.keyword),
            inverse: true,
            ...ax,
            axisLabel: { ...ax.axisLabel, width: 80, overflow: "truncate" },
          },
          series: [{
            type: "bar",
            data: kws.map((k) => k.count),
            itemStyle: { color: c.warning, borderRadius: [0, 2, 2, 0] },
            label: {
              show: true,
              position: "right",
              color: c.muted,
              fontSize: 10,
              fontFamily: "inherit",
            },
          }],
        }, true);
      }

      // 7. 標題字數 ─────────────────────────────────────────────────────────
      {
        const lenDist = titleLengthDistribution(d.series);
        getChart("chart-len")?.setOption({
          backgroundColor: "transparent",
          grid: grid(),
          tooltip: { trigger: "axis", ...tip(c) },
          xAxis: { type: "category", data: lenDist.map((b) => b.length), ...ax },
          yAxis: { type: "value", ...ax },
          series: [{ type: "bar", data: hasSeries ? lenDist.map((b) => b.count) : [], itemStyle: { color: c.muted, borderRadius: [2, 2, 0, 0] } }],
        }, true);
      }

      // 8. 星期 × 小時 熱力圖 ──────────────────────────────────────────────
      {
        const hm = publishHeatmap(arts);
        const peak = hm.data.reduce((a, b) => (b[2] > a[2] ? b : a), [0, 0, 0] as [number, number, number]);
        getChart("chart-heatmap")?.setOption({
          backgroundColor: "transparent",
          grid: { top: 16, right: 12, bottom: 48, left: 12, containLabel: true },
          tooltip: {
            ...tip(c),
            formatter: (p: any) =>
              `${hm.weekdays[p.value[1]]} · ${String(p.value[0]).padStart(2, "0")} 時：${p.value[2]} 篇`,
          },
          visualMap: {
            min: 0,
            max: peak[2] || 1,
            calculable: false,
            orient: "horizontal",
            left: "center",
            bottom: 4,
            itemWidth: 12,
            itemHeight: 120,
            textStyle: { color: c.muted, fontSize: 10, fontFamily: "inherit" },
            inRange: { color: [c.surfaceMuted, c.accent, c.warning] },
          },
          xAxis: {
            type: "category",
            data: hm.hours.map((h) => String(h).padStart(2, "0")),
            ...ax,
            axisLabel: { ...ax.axisLabel, interval: 2 },
            splitArea: { show: false },
          },
          yAxis: { type: "category", data: hm.weekdays, ...ax, splitArea: { show: false } },
          series: [{
            type: "heatmap",
            data: hasArts ? hm.data : [],
            label: { show: false },
            emphasis: { itemStyle: { borderColor: c.text, borderWidth: 1 } },
          }],
        }, true);
      }


      // 10. 斷更觀察：單日斷更落點分佈 ────────────────────────────────────────
      {
        const stale = staleObservation(d.series, taipeiToday());
        const staleDist = staleDayDistribution(d.series, taipeiToday());
        const totalStale = stale.length;
        getChart("chart-risk")?.setOption({
          backgroundColor: "transparent",
          grid: grid({ bottom: 24 }),
          tooltip: {
            trigger: "axis",
            ...tip(c),
            formatter: (p: any) => {
              const item = staleDist[p[0]?.dataIndex];
              if (!item) return "";
              const pct = totalStale > 0 ? ((item.count / totalStale) * 100).toFixed(1) : "0";
              return `<b>${item.label}</b><br/>斷更系列數：<b>${item.count}</b>（佔斷更 ${pct}%）`;
            },
          },
          xAxis: {
            type: "category",
            data: hasSeries ? staleDist.map((b) => b.label) : [],
            ...ax,
            axisLabel: { ...ax.axisLabel, interval: staleDist.length > 15 ? 1 : 0 },
          },
          yAxis: { type: "value", name: "斷更系列數", minInterval: 1, ...ax },
          series: [{
            type: "bar",
            data: hasSeries ? staleDist.map((b) => b.count) : [],
            itemStyle: { color: c.danger, borderRadius: [2, 2, 0, 0] },
            label: {
              show: true,
              position: "top",
              color: c.muted,
              fontSize: 10,
              fontFamily: "inherit",
              formatter: (p: any) => (p.value > 0 ? String(p.value) : ""),
            },
          }],
        }, true);
      }

      setLoadingState(false);
    }

    // ── Text updates ───────────────────────────────────────────────────────
    function setText(id: string, text: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function renderText(d: YearData) {
      const arts = d.series.flatMap((s) => s.articles);
      const hasSeries = d.series.length > 0;

      if (d.year === 0) {
        for (const id of ["insight-hour-line", "insight-group-line", "insight-kw-line", "insight-risk-line"])
          setText(id, "尚無資料");
        return;
      }

      if (arts.length === 0) {
        setText("insight-hour-line", "尚無發文資料");
      } else {
        const hour = publishHourHistogram(arts);
        const peak = hour.reduce((a, b) => (b.count > a.count ? b : a), hour[0]);
        setText("insight-hour-line", `${String(peak.hour).padStart(2, "0")} 時為發文高峰（${peak.count} 篇）`);
      }

      if (!hasSeries) {
        setText("insight-group-line", "尚無組別資料");
        setText("insight-kw-line", "尚無標題關鍵字");
      } else {
        const grps = groupStats(d.series);
        setText("insight-group-line", `${grps[0].group} 最活躍（${grps[0].seriesCount} 系列）`);
        const kws = titleKeywordStats(d.series, DEFAULT_KEYWORDS);
        setText("insight-kw-line", kws.length === 0 ? "尚無標題關鍵字" : `${kws[0].count} 個系列標題包含「${kws[0].keyword}」`);
      }
      const stale = staleObservation(d.series, taipeiToday());
      const staleDist = staleDayDistribution(d.series, taipeiToday());
      const peakStale = staleDist.length > 0 ? staleDist.reduce((a, b) => (b.count > a.count ? b : a), staleDist[0]) : null;
      setText(
        "insight-risk-line",
        stale.length === 0 || !peakStale || peakStale.count === 0
          ? "所有系列目前都有更新"
          : `${stale.length} 個系列已斷更 · 斷更高峰在 Day ${peakStale.day}（${peakStale.count} 系列）`,
      );
    }

    // ── Full render ────────────────────────────────────────────────────────
    function render(d: YearData) {
      currentYear = d.year;
      currentData = d;
      renderText(d);
      renderCharts(d);
      const sel = document.getElementById("insight-year-select") as HTMLSelectElement | null;
      if (sel) sel.value = String(d.year);
    }

    // ── Fetch year ─────────────────────────────────────────────────────────
    function fetchYear(year: number) {
      const token = ++fetchToken;
      const sel = document.getElementById("insight-year-select") as HTMLSelectElement | null;
      setLoadingState(true);
      // Plain URL, default cache mode: the `?t=` buster made every request a
      // unique key (guaranteed edge miss) and `no-store` disabled the browser
      // cache on top. /data/* already ships `max-age=60,
      // stale-while-revalidate=300`, which is exactly the freshness this needs.
      fetch(`/data/${year}.json`)
        .then((res) => (res.ok ? res.json() : Promise.reject(new Error(`HTTP ${res.status}`))))
        .then((fresh) => {
          if (token !== fetchToken) return null;
          if (!isYearData(fresh)) throw new Error("invalid year data");
          return fresh;
        })
        .then((fresh) => {
          if (!fresh || token !== fetchToken) return;
          render(fresh);
          history.replaceState(null, "", `?year=${fresh.year}`);
        })
        .catch(() => {
          if (token !== fetchToken) return;
          if (sel) sel.value = String(currentYear);
          setLoadingState(false);
          showToast();
        });
    }

    // ── Theme re-render ────────────────────────────────────────────────────
    new MutationObserver(() => {
      disposeAll();
      setLoadingState(true);
      requestAnimationFrame(() => renderCharts(currentData));
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    // ── Resize ────────────────────────────────────────────────────────────
    window.addEventListener("resize", () => {
      chartInstances.forEach((inst) => inst.resize());
    });

    // ── Year select ───────────────────────────────────────────────────────
    document.getElementById("insight-year-select")?.addEventListener("change", (e) => {
      const y = Number((e.target as HTMLSelectElement).value);
      if (Number.isInteger(y) && y !== 0) fetchYear(y);
    });

    // ── Init ──────────────────────────────────────────────────────────────
    const q = new URLSearchParams(location.search).get("year");
    const initYear = yearsList.includes(Number(q)) ? Number(q) : initialData.year;
    if (initYear !== initialData.year && initYear !== 0) {
      fetchYear(initYear);
    } else {
      render(initialData);
      if (initialData.year !== 0) history.replaceState(null, "", `?year=${initialData.year}`);
    }
  </script>
</body>
</html>
